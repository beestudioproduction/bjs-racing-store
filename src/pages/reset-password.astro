---
// src/pages/reset-password.astro
// Halaman landing tautan reset kata sandi dari email.
// Sengaja di luar /akun/* agar tidak terkena proteksi middleware:
// saat link email dibuka, sesi belum terbentuk di sisi server.
export const prerender = true;

import MainLayout from '../layouts/MainLayout.astro';
import ResetPasswordView from '../components/ResetPasswordView.jsx';
---

<MainLayout title="Reset Kata Sandi - BJS RACING STORE">
    <div class="container mx-auto px-4 py-16">
        <h1 class="text-3xl font-bold text-center mb-8">Reset Kata Sandi</h1>
        <div class="max-w-md mx-auto">
            <ResetPasswordView client:only="react" />
        </div>
    </div>
</MainLayout>
