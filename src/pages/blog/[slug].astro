---
// File: /src/pages/blog/[slug].astro
import MainLayout from '../../layouts/MainLayout.astro';
import { supabaseAdmin } from '../../lib/supabaseServer';
import CommentSection from '../../components/feed/CommentSection.jsx';
import YouTubeEmbed from '../../components/YouTubeEmbed';
import OptimizedImage from '../../components/OptimizedImage.astro';

export const prerender = false;

const { slug } = Astro.params;

const { data: post } = await supabaseAdmin
  .from('feed_posts')
  .select('*, products(id, nama, harga_jual, image_url), feed_post_products(post_id, product_id, products(id, nama, harga_jual, image_url))')
  .eq('slug', slug)
  .eq('is_published', true)
  .single();

if (!post) {
  // 404 sungguhan (bukan redirect) agar mesin pencari mendekatalog URL
  // artikel yang sudah tidak ada.
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Artikel publik tanpa personalisasi — disimpan di CDN (bot & pengunjung baru
// tidak memanggil function). Salinan maksimal 5 menit, disegarkan di latar.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=86400",
);

function getDriveDirectUrl(url: string) {
  if (!url || !url.includes('drive.google.com')) return url;
  const idMatch = url.match(/[-\w]{25,}/);
  if (idMatch) return `https://drive.google.com/uc?export=view&id=${idMatch[0]}`;
  return url;
}

function getYouTubeId(url: string) {
  if (!url) return null;
  const regExp = /^.*((youtu.be\/)|(v\/)|(\/u\/\w\/)|(embed\/)|(watch\?)|(?:shorts\/))\??v?=?([^#&?]*).*/;
  const match = url.match(regExp);
  return match && match[7] && match[7].length === 11 ? match[7] : null;
}

const relatedProducts = (post.feed_post_products ?? [])
  .map((item: any) => item.products)
  .filter(Boolean);

const ogImage = post.media_url ? getDriveDirectUrl(post.media_url) : null;
const postDescription = post.content?.replace(/<[^>]*>/g, '').slice(0, 160);
const youtubeVideoId = getYouTubeId(post.youtube_url);
---

<MainLayout
  title={`${post.title} - BJS Racing Blog`}
  description={postDescription}
  ogImage={ogImage || undefined}
  canonicalPath={`/blog/${post.slug}`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    image: ogImage ? [ogImage] : undefined,
    datePublished: post.published_at,
    dateModified: post.updated_at ?? post.published_at,
    author: {
      "@type": "Organization",
      name: "BJS Racing Store",
      url: "https://bjsracing.com",
    },
    publisher: {
      "@type": "Organization",
      name: "BJS Racing Store",
      logo: {
        "@type": "ImageObject",
        url: "https://bjsracing.com/favicon.svg",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `https://bjsracing.com/blog/${post.slug}`,
    },
  })} slot="head-scripts" />

  <div class="max-w-4xl mx-auto px-4 py-8">
      <a href="/blog" class="inline-flex items-center text-sm text-slate-500 hover:text-orange-500 mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Kembali ke Blog
      </a>

    <article class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      {(post.post_type === 'video' && youtubeVideoId) ? (
        <div class="mb-6">
          <YouTubeEmbed
            videoId={youtubeVideoId}
            title={post.title}
            client:load
          />
        </div>
      ) : post.media_url && (
        <div class="relative aspect-video bg-slate-100">
          <OptimizedImage src={getDriveDirectUrl(post.media_url)} alt={post.title} width={800} class="w-full h-full object-cover" />
        </div>
      )}

      <div class="p-6 md:p-8">
        <div class="flex items-center gap-2 mb-3">
          <span class="bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-md">
            {post.category || post.post_type}
          </span>
          {post.is_featured && (
            <span class="bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-md">
              Unggulan
            </span>
          )}
          <span class="text-xs text-slate-400">
            {post.published_at ? new Date(post.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : ''}
          </span>
        </div>

        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">{post.title}</h1>

        <div class="prose prose-slate max-w-none mb-8 text-slate-700 leading-relaxed">
          {post.content}
        </div>

        {(post.post_type !== 'video' || !youtubeVideoId) && post.youtube_url && youtubeVideoId && (
          <div class="mb-8">
            <YouTubeEmbed
              videoId={youtubeVideoId}
              title={post.title}
              client:load
            />
          </div>
        )}

        {relatedProducts.length > 0 && (
          <div class="border-t border-slate-100 pt-6 mb-6">
            <h3 class="text-lg font-bold text-slate-800 mb-3">Produk Terkait</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {relatedProducts.map((product: any) => (
                <a href={`/products/${product.id}`} class="flex items-center gap-3 p-3 bg-orange-50 rounded-lg hover:bg-orange-100 transition-colors">
                  {product.image_url && (
                    <OptimizedImage src={product.image_url} alt={product.nama} width={150} class="w-16 h-16 object-contain rounded-md bg-white" />
                  )}
                  <div>
                    <p class="font-semibold text-slate-800">{product.nama}</p>
                    <p class="text-sm text-orange-600 font-bold">
                      {new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.harga_jual || 0)}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </article>

    <div class="mt-8">
      <CommentSection postId={post.id} client:visible />
    </div>
  </div>
</MainLayout>
