---
// BlogHero.astro — Hero featured post di halaman blog index
interface Props {
  post: {
    slug: string;
    title: string;
    content?: string;
    media_url?: string;
    youtube_url?: string;
    post_type?: string;
    category?: string;
    published_at?: string;
  };
}

const { post } = Astro.props;

function getYouTubeId(url: string) {
  if (!url) return null;
  const regExp = /^.*((youtu.be\/)|(v\/)|(\/u\/\w\/)|(embed\/)|(watch\?)|(?:shorts\/))\??v?=?([^#&?]*).*/;
  const match = url.match(regExp);
  return match && match[7] && match[7].length === 11 ? match[7] : null;
}

function getDriveDirectUrl(url: string) {
  if (!url || !url.includes('drive.google.com')) return url;
  const idMatch = url.match(/[-\w]{25,}/);
  if (idMatch) return `https://drive.google.com/uc?export=view&id=${idMatch[0]}`;
  return url;
}

const ytId = getYouTubeId(post.youtube_url || '');
const mediaUrl = getDriveDirectUrl(post.media_url || '');
const slug = `/blog/${post.slug}`;

const plainText = (post.content ?? '').replace(/<[^>]*>/g, ' ').trim();
const wordCount = plainText ? plainText.split(/\s+/).length : 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));
---

<a href={slug} class="group block relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden mb-6">
  {ytId ? (
    <img
      src={`https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`}
      alt={post.title}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="eager"
    />
  ) : mediaUrl ? (
    <img
      src={mediaUrl}
      alt={post.title}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="eager"
    />
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-orange-600 to-orange-400" />
  )}

  {/* Overlay gradient */}
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />

  {/* Video play badge */}
  {ytId && (
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="w-16 h-16 rounded-full bg-white/90 flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-200">
        <svg class="w-7 h-7 text-orange-600 ml-1" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </div>
    </div>
  )}

  {/* Content overlay */}
  <div class="absolute inset-x-0 bottom-0 p-4 md:p-6">
    <div class="flex items-center gap-2 mb-2">
      <span class="bg-orange-500 text-white text-[11px] font-bold px-2.5 py-1 rounded-md">
        {post.category || post.post_type || 'Artikel'}
      </span>
      {ytId && (
        <span class="bg-red-500 text-white text-[11px] font-bold px-2.5 py-1 rounded-md flex items-center gap-1">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          Video
        </span>
      )}
    </div>
    <h2 class="text-lg md:text-2xl font-bold text-white leading-snug line-clamp-2 mb-1.5 group-hover:text-orange-200 transition-colors">
      {post.title}
    </h2>
    <div class="flex items-center gap-3 text-xs text-white/70">
      {post.published_at && (
        <span>{new Date(post.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
      )}
      <span class="w-1 h-1 bg-white/40 rounded-full" />
      <span>{readMinutes} menit baca</span>
    </div>
  </div>
</a>
