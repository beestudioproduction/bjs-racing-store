---
// File: src/pages/checkout.astro
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CheckoutView from '@/components/CheckoutView.tsx';
import { supabaseAdmin } from '@/lib/supabaseServer.ts';

const { session } = Astro.locals;

// Guard maintenance: saat CHECKOUT_ENABLED=false, halaman checkout dialihkan ke /cart
// (pengaman tambahan; redirect utama sudah ditangani middleware).
const checkoutEnabled = import.meta.env.CHECKOUT_ENABLED !== "false";
if (!checkoutEnabled) {
  return Astro.redirect('/cart');
}

if (!session) {
  return Astro.redirect('/login?redirect=/checkout');
}

const midtransClientKey = import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY;

const orderId = Astro.url.searchParams.get('order_id');
let initialItems;
if (orderId) {
  const { data } = await supabaseAdmin
    .from('orders')
    .select('*, order_items(*)')
    .eq('id', orderId)
    .eq('status', 'awaiting_payment')
    .single();

  if (data?.order_items && data.order_items.length > 0) {
    const productIds = data.order_items.map((it: any) => it.product_id);
    const { data: products } = await supabaseAdmin
      .from('products')
      .select('*')
      .in('id', productIds);

    const productMap = new Map((products || []).map((p: any) => [p.id, p]));

    initialItems = data.order_items.map((it: any) => {
      const product = productMap.get(it.product_id) || {};
      return {
        id: it.product_id,
        product_id: it.product_id,
        quantity: it.quantity,
        nama: product.nama || 'Produk',
        harga_jual: it.price,
        image_url: product.image_url || '',
        berat_gram: product.berat_gram ?? 0,
        panjang_cm: product.panjang_cm,
        lebar_cm: product.lebar_cm,
        tinggi_cm: product.tinggi_cm,
        merek: product.merek,
        ukuran: product.ukuran,
        sku: product.sku,
        stok: product.stok || 999,
      };
    });
  }
}
---

<MainLayout title="Checkout - BJS RACING STORE" hideWhatsApp={true} hideBottomNav={true} hideFooter={true}>
  {/* Midtrans Snap.js dimuat secara manual di CheckoutView.tsx */}
  {/* Konten utama halaman akan otomatis masuk ke <slot /> di MainLayout */}
  <div class="container mx-auto px-4">
    <PageHeader title="Checkout" backHref="/cart" />
    <CheckoutView client:load {...{ orderId: orderId ?? undefined, initialItems }} />
  </div>
</MainLayout>