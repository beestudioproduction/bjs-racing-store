# Supabase (lihat di Project Settings > API)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Midtrans (mode Sandbox saat develop)
MIDTRANS_SERVER_KEY=your-midtrans-server-key
PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
# Set true HANYA setelah akun produksi approved & keys production terpasang.
# Mengubah URL API & snap.js otomatis (lihat docs/midtrans-golive-plan.md).
PUBLIC_MIDTRANS_IS_PRODUCTION=false

# RajaOngkir (lihat di https://rajaongkir.com/)
RAJAONGKIR_API_KEY=your-rajaongkir-api-key
RAJAONGKIR_ORIGIN_ID=your-store-origin-city-or-subdistrict-id

# Biteship (lihat di https://biteship.com/)
BITESHIP_API_KEY=your-biteship-api-key
BITESHIP_ORIGIN_LAT=-6.5244682
BITESHIP_ORIGIN_LNG=110.7674915
BITESHIP_ORIGIN_NAME=BJS Racing Store
BITESHIP_ORIGIN_PHONE=+62881011669213
BITESHIP_ORIGIN_ADDRESS=Jl. Wijaya Kusuma No.79 Toko BJS RACING, Desa Bangsri, Kec. Bangsri, Kab. Jepara, Jawa Tengah 59453
BITESHIP_ORIGIN_POSTAL=59453
BITESHIP_WEBHOOK_KEY=X-Biteship-Signature
BITESHIP_WEBHOOK_SECRET=your-biteship-webhook-secret
BITESHIP_WEBHOOK_URL=https://your-domain.com/api/shipping/biteship/webhook

# WhatsApp Notification (FONNTE)
WHATSAPP_PROVIDER=fonnte
FONNTE_API_KEY=your-fonnte-api-key
FONNTE_SENDER_NUMBER=+62881011669213
FONNTE_TIMEZONE=+7

# Admin
ADMIN_API_TOKEN=your-admin-api-token

# Cron
CRON_JOB_API_KEY=your-cron-job-api-key

# Maintenance Checkout (set false untuk menonaktifkan halaman checkout sementara,
# mis. saat payment/shipping masih proses verifikasi). Default: true (aktif).
CHECKOUT_ENABLED=true

# Tombol chat WhatsApp mengambang di kanan-bawah (default: tersembunyi).
# Set "1" untuk menampilkannya kembali.
# PUBLIC_ENABLE_WA_BUTTON=1
