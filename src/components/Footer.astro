---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---
<footer class="bg-slate-800 text-slate-400 mt-8 mobile:mt-10 tablet:mt-16">
    <div class="container mx-auto px-2.5 mobile:px-3 tablet:px-5 py-4 mobile:py-6">
        {/* Grid Layout untuk Tablet/Desktop */}
        <div class="grid grid-cols-1 tablet:grid-cols-3 gap-4 mobile:gap-5 tablet:gap-8 mb-4 mobile:mb-6">
            {/* Company Info */}
            <div class="text-center tablet:text-left">
                <h3 class="text-sm mobile:text-base tablet:text-lg font-bold text-white mb-2 mobile:mb-3">
                    BJS RACING STORE
                </h3>
                <p class="text-xs mobile:text-sm text-slate-400">
                    Distributor Spray Paint dan Onderdil Motor Terpercaya
                </p>
            </div>

            {/* Contact Info */}
            <div class="text-center">
                <h4 class="text-xs mobile:text-sm font-semibold text-white mb-1.5 mobile:mb-2">
                    Kontak Kami
                </h4>
                <p class="text-xs mobile:text-xs text-slate-400">Email: bjs.racing.store@gmail.com</p>
                <p class="text-xs mobile:text-xs text-slate-400">WhatsApp: 0881011669213</p>
            </div>

            {/* Social Media */}
            <div class="text-center tablet:text-right">
                <h4 class="text-xs mobile:text-sm font-semibold text-white mb-1.5 mobile:mb-2">
                    Follow Kami
                </h4>
                <div class="flex justify-center tablet:justify-end space-x-4">
                    <a href="#" class="text-slate-400 hover:text-orange-500 transition-colors text-sm">
                        Instagram
                    </a>
                    <a href="#" class="text-slate-400 hover:text-orange-500 transition-colors text-sm">
                        Facebook
                    </a>
                </div>
            </div>
        </div>

        {/* Legal Links */}
        <div class="flex flex-wrap justify-center gap-x-5 gap-y-2 mb-4 mobile:mb-6 text-xs mobile:text-sm">
            <a href="/syarat-ketentuan" class="hover:text-orange-500 transition-colors">
                Syarat &amp; Ketentuan
            </a>
            <a href="/kebijakan-privasi" class="hover:text-orange-500 transition-colors">
                Kebijakan Privasi
            </a>
            <a href="/kebijakan-pengembalian" class="hover:text-orange-500 transition-colors">
                Kebijakan Pengembalian
            </a>
        </div>

        {/* Copyright Section */}
        <div class="border-t border-slate-700 pt-4 mobile:pt-6 text-center">
            <p class="text-xs mobile:text-sm tablet:text-base">
                &copy; {currentYear} BJS RACING STORE. All rights reserved.
            </p>
            <p class="text-xs mobile:text-xs mt-2 tablet:mt-3">
                Developed with ❤️ for the automotive community
            </p>
        </div>
    </div>
</footer>