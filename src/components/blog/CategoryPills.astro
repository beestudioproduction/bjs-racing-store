---
// CategoryPills.astro — Kategori filter pills untuk blog index
interface Props {
  activeCategory?: string;
}

const { activeCategory } = Astro.props;

const categories = [
  { label: 'Semua', value: '' },
  { label: 'Tips Spray Paint', value: 'tips_spray_paint' },
  { label: 'Panduan Sparepart', value: 'panduan_sparepart' },
  { label: 'News & Trends', value: 'news' },
  { label: 'Behind the Scene', value: 'bts' },
];
---

<div class="mb-5 -mx-4 px-4 overflow-x-auto scrollbar-hide">
  <div class="flex items-center gap-2 min-w-max">
    {categories.map((cat) => {
      const isActive = cat.value === (activeCategory || '');
      const href = cat.value ? `/blog?category=${cat.value}` : '/blog';
      return (
        <a
          href={href}
          class:list={[
            'inline-flex items-center px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 whitespace-nowrap',
            isActive
              ? 'bg-orange-500 text-white shadow-sm'
              : 'bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-800',
          ]}
        >
          {cat.label}
        </a>
      );
    })}
  </div>
</div>
