---
// src/pages/cart.astro
import MainLayout from '../layouts/MainLayout.astro';
import CartView from '../components/CartView.jsx';
import PageHeader from '../components/PageHeader.astro';

const checkoutEnabled = import.meta.env.CHECKOUT_ENABLED !== "false";
---

<MainLayout title="Keranjang Belanja - BJS RACING STORE" hideWhatsApp={true} hideBottomNav={true} hideFooter={true}>
    <div class="container mx-auto px-4">
        <PageHeader title="Keranjang Belanja" />

        <!-- Skeleton: tampil selagi CartView (client:only) hydrate,
             dihapus otomatis oleh useEffect di CartView -->
        <div id="cart-skeleton" class="space-y-2" aria-hidden="true">
            <div class="bg-white rounded-xl border border-slate-100 px-3 py-2.5">
                <div class="h-4 w-36 bg-slate-100 rounded animate-pulse"></div>
            </div>
            {[1, 2].map(() => (
                <div class="bg-white rounded-xl border border-slate-100 p-2.5">
                    <div class="flex gap-2.5">
                        <div class="w-5 h-5 rounded bg-slate-100 animate-pulse"></div>
                        <div class="w-[85px] h-[85px] rounded-lg bg-slate-100 animate-pulse"></div>
                        <div class="flex-1 space-y-2 py-1">
                            <div class="h-3.5 w-4/5 bg-slate-100 rounded animate-pulse"></div>
                            <div class="h-3 w-2/5 bg-slate-100 rounded animate-pulse"></div>
                            <div class="h-3 w-3/5 bg-slate-100 rounded animate-pulse"></div>
                        </div>
                    </div>
                    <div class="flex justify-between mt-2.5 pt-2.5 border-t border-slate-50">
                        <div class="h-4 w-24 bg-slate-100 rounded animate-pulse"></div>
                        <div class="h-8 w-28 bg-slate-100 rounded-lg animate-pulse"></div>
                    </div>
                </div>
            ))}
        </div>

        <CartView client:only="react" checkoutEnabled={checkoutEnabled} />

    </div>
</MainLayout>