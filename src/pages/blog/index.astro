---
// File: /src/pages/blog/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { supabaseAdmin } from '../../lib/supabaseServer';
import VerticalFeed from '../../components/feed/VerticalFeed.jsx';

export const prerender = false;

// Halaman publik tanpa personalisasi — disimpan di CDN sehingga mayoritas hit
// (bot & pengunjung baru) tidak memanggil function sama sekali.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=86400",
);

const posts = await supabaseAdmin
  .from('feed_posts')
  .select('*, products(id, nama, harga_jual, image_url), feed_comments(count)')
  .eq('is_published', true)
  .order('published_at', { ascending: false })
  .limit(20);

const featured = posts.data?.filter(p => p.is_featured) || [];
const regular = posts.data?.filter(p => !p.is_featured) || [];

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Tips & Trik BJS Racing Store",
  "description": "Tips & trik cat semprot motor, pilok, dan onderdil dari praktisi BJS Racing Store.",
  "url": "https://bjsracing.com/blog",
  "publisher": {
    "@type": "Organization",
    "name": "BJS Racing Store",
    "logo": {
      "@type": "ImageObject",
      "url": "https://bjsracing.com/favicon.svg"
    }
  }
};
---

<MainLayout
  title="Tips & Trik Cat Semprot & Onderdil Motor | BJS Racing Store"
  description="Kumpulan tips & trik cat semprot motor, pilok, dan onderdil dari praktisi BJS Racing Store — tutorial lengkap dengan video."
  canonicalPath="/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} slot="head-scripts" />

  <div class="max-w-7xl mx-auto px-4">
    <PageHeader title="Tips & Trik Cat Semprot & Onderdil Motor" />

    {/* Mobile: feed vertikal ala Shorts; Desktop: grid editorial (diatur di dalam komponen) */}
    <VerticalFeed client:load posts={[...featured, ...regular]} />

    {/* Fallback SEO tanpa JavaScript */}
    <noscript>
      <ul class="py-4 space-y-2">
        {[...featured, ...regular].map((post) => (
          <li><a class="text-orange-600 underline" href={`/blog/${post.slug}`}>{post.title}</a></li>
        ))}
      </ul>
    </noscript>
  </div>
</MainLayout>
