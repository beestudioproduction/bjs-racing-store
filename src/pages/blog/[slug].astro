---
// File: /src/pages/blog/[slug].astro
import MainLayout from '../../layouts/MainLayout.astro';
import { supabaseAdmin } from '../../lib/supabaseServer';
import CommentSection from '../../components/feed/CommentSection.jsx';
import FeedCard from '../../components/feed/FeedCard.jsx';
import YouTubeEmbed from '../../components/YouTubeEmbed';
import OptimizedImage from '../../components/OptimizedImage.astro';
import ShareBar from '../../components/blog/ShareBar.jsx';

export const prerender = false;

const { slug } = Astro.params;

const { data: post } = await supabaseAdmin
  .from('feed_posts')
  .select('*, products(id, nama, harga_jual, image_url), feed_post_products(post_id, product_id, products(id, nama, harga_jual, image_url))')
  .eq('slug', slug)
  .eq('is_published', true)
  .single();

if (!post) {
  // 404 sungguhan (bukan redirect) agar mesin pencari mendekatalog URL
  // artikel yang sudah tidak ada.
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Artikel publik tanpa personalisasi — disimpan di CDN (bot & pengunjung baru
// tidak memanggil function). Salinan maksimal 5 menit, disegarkan di latar.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=86400",
);

function getDriveDirectUrl(url: string) {
  if (!url || !url.includes('drive.google.com')) return url;
  const idMatch = url.match(/[-\w]{25,}/);
  if (idMatch) return `https://drive.google.com/uc?export=view&id=${idMatch[0]}`;
  return url;
}

function getYouTubeId(url: string) {
  if (!url) return null;
  const regExp = /^.*((youtu.be\/)|(v\/)|(\/u\/\w\/)|(embed\/)|(watch\?)|(?:shorts\/))\??v?=?([^#&?]*).*/;
  const match = url.match(regExp);
  return match && match[7] && match[7].length === 11 ? match[7] : null;
}

// Navigasi artikel sebelumnya & berikutnya (berdasarkan tanggal publikasi)
const { data: prevPost } = await supabaseAdmin
  .from('feed_posts')
  .select('id, slug, title')
  .eq('is_published', true)
  .lt('published_at', post.published_at)
  .order('published_at', { ascending: false })
  .limit(1)
  .maybeSingle();

const { data: nextPost } = await supabaseAdmin
  .from('feed_posts')
  .select('id, slug, title')
  .eq('is_published', true)
  .gt('published_at', post.published_at)
  .order('published_at', { ascending: true })
  .limit(1)
  .maybeSingle();

const { data: relatedPosts } = await supabaseAdmin
  .from('feed_posts')
  .select('id, slug, title, media_url, youtube_url, post_type, category, is_featured, feed_comments(count)')
  .eq('is_published', true)
  .neq('id', post.id)
  .order('published_at', { ascending: false })
  .limit(4);

const relatedProducts = (post.feed_post_products ?? [])
  .map((item: any) => item.products)
  .filter(Boolean);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Beranda", item: "https://bjsracing.com/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://bjsracing.com/blog" },
    ...(post.category
      ? [{ "@type": "ListItem", position: 3, name: post.category.toLowerCase(), item: `https://bjsracing.com/blog?category=${encodeURIComponent(post.category)}` }]
      : []),
    { "@type": "ListItem", position: post.category ? 4 : 3, name: post.title, item: `https://bjsracing.com/blog/${post.slug}` },
  ],
};

// Estimasi waktu baca (≈ 200 kata/menit untuk Bahasa Indonesia)
const plainText = (post.content ?? '').replace(/<[^>]*>/g, ' ').trim();
const wordCount = plainText ? plainText.split(/\s+/).length : 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const ogImage = post.media_url ? getDriveDirectUrl(post.media_url) : null;
const postDescription = post.content?.replace(/<[^>]*>/g, '').slice(0, 160);
const youtubeVideoId = getYouTubeId(post.youtube_url);
---

<MainLayout
  title={`${post.title} - BJS Racing Blog`}
  description={postDescription}
  ogImage={ogImage || undefined}
  canonicalPath={`/blog/${post.slug}`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    image: ogImage ? [ogImage] : undefined,
    datePublished: post.published_at,
    dateModified: post.updated_at ?? post.published_at,
    author: {
      "@type": "Organization",
      name: "BJS Racing Store",
      url: "https://bjsracing.com",
    },
    publisher: {
      "@type": "Organization",
      name: "BJS Racing Store",
      logo: {
        "@type": "ImageObject",
        url: "https://bjsracing.com/favicon.svg",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `https://bjsracing.com/blog/${post.slug}`,
    },
  })} slot="head-scripts" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head-scripts" />

  <div class="max-w-4xl mx-auto px-4 py-8">
      <nav aria-label="Breadcrumb" class="mb-3">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-orange-500 transition-colors">Beranda</a></li>
          <li class="text-slate-300">/</li>
          <li><a href="/blog" class="hover:text-orange-500 transition-colors">Blog</a></li>
          {post.category && (
            <>
              <li class="text-slate-300">/</li>
              <li>
                <a href={`/blog?category=${encodeURIComponent(post.category)}`} class="text-slate-700 font-medium hover:text-orange-500 transition-colors">
                  {post.category.toLowerCase()}
                </a>
              </li>
            </>
          )}
        </ol>
      </nav>

      <a href="/blog" class="inline-flex items-center text-sm text-slate-500 hover:text-orange-500 mb-4 transition-colors">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
       </svg>
        Kembali ke Blog
     </a>

      {/* Bar progres bacaan mengikuti scroll dalam isi artikel */}
      <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-orange-500 z-[60] pointer-events-none" style="width:0%"></div>

    <article class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      {(post.post_type === 'video' && youtubeVideoId) ? (
        <div class="mb-6">
          <YouTubeEmbed
            videoId={youtubeVideoId}
            title={post.title}
            client:load
          />
        </div>
      ) : post.media_url && (
        <div class="relative aspect-video bg-slate-100">
          <OptimizedImage src={getDriveDirectUrl(post.media_url)} alt={post.title} width={800} class="w-full h-full object-cover" />
</div>
        )}

        <ShareBar title={post.title} slug={post.slug} client:visible />

        {relatedProducts.length > 0 && (
          <div class="sm:hidden fixed bottom-16 left-0 right-0 z-40 bg-white/95 backdrop-blur border-t border-slate-200 shadow-[0_-2px_10px_rgba(0,0,0,0.06)]">
            <a href={`/products/${relatedProducts[0].id}`} class="flex items-center gap-3 px-4 py-2.5">
              {relatedProducts[0].image_url && (
                <img src={relatedProducts[0].image_url} alt="" class="w-10 h-10 rounded-md object-contain bg-slate-50" />
              )}
              <div class="flex-1 min-w-0">
                <p class="text-xs font-semibold text-slate-800 truncate">{relatedProducts[0].nama}</p>
                <p class="text-[11px] text-orange-600 font-bold">
                  {new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(relatedProducts[0].harga_jual || 0)}
                </p>
              </div>
              <span class="text-xs font-bold text-white bg-orange-500 px-3 py-1.5 rounded-lg">Lihat</span>
            </a>
          </div>
        )}

      <div class="p-6 md:p-8">
        <div class="flex items-center gap-2 mb-3">
          <span class="bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-md">
            {post.category || post.post_type}
          </span>
          {post.is_featured && (
            <span class="bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-md">
              Unggulan
            </span>
          )}
          <span class="text-xs text-slate-400">
            {post.published_at ? new Date(post.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : ''}
         </span>
          <span class="text-xs text-slate-400">·</span>
          <span class="text-xs text-slate-400">{readMinutes} menit baca</span>
       </div>

        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">{post.title}</h1>

        <div id="article-content" class="prose prose-slate max-w-none mb-8 text-slate-700 leading-relaxed">
          {post.content}
       </div>

        {(post.post_type !== 'video' || !youtubeVideoId) && post.youtube_url && youtubeVideoId && (
          <div class="mb-8">
            <YouTubeEmbed
              videoId={youtubeVideoId}
              title={post.title}
              client:load
            />
          </div>
        )}

        {relatedProducts.length > 0 && (
          <div class="border-t border-slate-100 pt-6 mb-6">
            <h3 class="text-lg font-bold text-slate-800 mb-3">Produk Terkait</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {relatedProducts.map((product: any) => (
                <a href={`/products/${product.id}`} class="flex items-center gap-3 p-3 bg-orange-50 rounded-lg hover:bg-orange-100 transition-colors">
                  {product.image_url && (
                    <OptimizedImage src={product.image_url} alt={product.nama} width={150} class="w-16 h-16 object-contain rounded-md bg-white" />
                  )}
                  <div>
                    <p class="font-semibold text-slate-800">{product.nama}</p>
                    <p class="text-sm text-orange-600 font-bold">
                      {new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.harga_jual || 0)}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </article>

    <div class="mt-8">
      <CommentSection postId={post.id} client:visible />
    </div>

    <script is:inline>
      (function() {
        var bar = document.getElementById('reading-progress');
        var target = document.getElementById('article-content');
        if (!bar || !target) return;
        function update() {
          var rect = target.getBoundingClientRect();
          var total = target.offsetHeight - window.innerHeight;
          var passed = -rect.top;
          var pct = total > 0 ? Math.max(0, Math.min(100, (passed / total) * 100)) : 0;
          bar.style.width = pct + '%';
        }
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>

    {(relatedPosts || []).length > 0 && (
      <div class="mt-8">
        <h3 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2">
          <span class="w-2 h-6 bg-orange-500 rounded-full"></span>
          Artikel Terkait
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {(relatedPosts || []).map((rp: any) => (
            <FeedCard key={rp.id} post={rp} />
          ))}
         </div>
      </div>
    )}

    {(prevPost || nextPost) && (
      <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="Navigasi artikel">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`}
             class="flex items-center gap-3 p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-orange-200 hover:bg-orange-50 group transition-colors">
            <span class="text-orange-500 text-lg leading-none select-none">←</span>
            <div>
              <span class="text-xs text-slate-400 block">Sebelumnya</span>
              <span class="font-semibold text-sm text-slate-800 line-clamp-2 group-hover:text-orange-700">{prevPost.title}</span>
            </div>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`}
             class="flex items-center justify-end gap-3 p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-orange-200 hover:bg-orange-50 group transition-colors sm:text-right">
            <div>
              <span class="text-xs text-slate-400 block">Selanjutnya</span>
              <span class="font-semibold text-sm text-slate-800 line-clamp-2 group-hover:text-orange-700">{nextPost.title}</span>
            </div>
            <span class="text-orange-500 text-lg leading-none select-none">→</span>
          </a>
        ) : <div />}
      </nav>
    )}
  </div>
</MainLayout>
