---
// src/pages/index.astro
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import id from '../../public/locales/id/common.json';
import PromoBanner from '../components/PromoBanner.tsx';
import StatsCounter from '../components/StatsCounter.tsx';
import VideoShowcase from '../components/VideoShowcase.jsx';
import BrandMarquee from '../components/BrandMarquee.tsx';
import FeaturedProducts from '../components/FeaturedProducts.jsx';
import FlashSaleSection from '../components/FlashSaleSection.jsx';
import CategoriesPreview from '../components/CategoriesPreview.jsx';
import TrustBadges from '../components/TrustBadges.jsx';
import WhyChooseUs from '../components/WhyChooseUs.jsx';
import TestimonialSection from '../components/TestimonialSection.jsx';
import NewsletterBanner from '../components/NewsletterBanner.jsx';
import { supabaseAdmin } from '../lib/supabaseServer';

// Beranda dirender per-request (SSR) agar daftar promo dihitung dengan
// tanggal saat ini — promo kedaluarsa tidak lagi "beku" di snapshot build
// statis. Disimpan di CDN (bot & pengunjung baru tidak memanggil function
// kecuali saat cache kadaluarsa).
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=86400",
);

// Ambil data statistik dari database
const { count: totalProduk } = await supabaseAdmin
  .from('products')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'Aktif');

const { data: terjualData } = await supabaseAdmin
  .from('products')
  .select('total_terjual');

const totalTerjual = terjualData?.reduce((sum, p) => sum + (p.total_terjual || 0), 0) ?? 0;

// Ambil data promo aktif dari database (auto-hide jika sudah kedaluwarsa)
const { data: promos, error: promosError } = await supabaseAdmin
  .from('promos')
  .select('id, title, subtitle, cta_text, cta_href, image_url, bg_gradient, sort_order, valid_from, valid_until')
  .eq('is_active', true)
  .order('sort_order', { ascending: true })
  .limit(7);

if (promosError) console.error('Gagal mengambil promo:', promosError.message);

const now = new Date();
const activePromos = promos?.filter(p => {
  const from = p.valid_from ? new Date(p.valid_from) : null;
  const until = p.valid_until ? new Date(p.valid_until) : null;
  return (!from || from <= now) && (!until || until >= now);
}) ?? [];

// Ambil data brand aktif dari database
const { data: brands } = await supabaseAdmin
  .from('brands')
  .select('id, name, logo_url')
  .eq('is_active', true)
  .order('sort_order', { ascending: true });
---

<MainLayout title="BJS RACING STORE - Home">
    <PromoBanner client:load slides={activePromos as any} />

    {/* Hero Section - Split Layout */}
    <section class="relative bg-gradient-to-br from-orange-600 via-orange-500 to-orange-600 text-white overflow-hidden">
        {/* Racing Pattern Background */}
        <svg class="absolute inset-0 w-full h-full opacity-[0.06]" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <pattern id="hero-racing" x="0" y="0" width="80" height="80" patternUnits="userSpaceOnUse">
                    <path d="M0 40 L40 0 L80 40 L40 80 Z" fill="none" stroke="white" stroke-width="1.2"/>
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#hero-racing)"/>
        </svg>
        <div class="absolute inset-0 bg-gradient-to-t from-orange-900/20 to-transparent"></div>

        {/* Floating Promo Badge */}
        <div class="absolute top-4 right-4 tablet:top-6 tablet:right-8 z-20 animate-[pulse_3s_ease-in-out_infinite]">
            <div class="bg-white text-orange-600 px-4 py-2 rounded-full font-bold text-xs mobile:text-xs shadow-lg border border-orange-100">
                <span class="inline-block w-2 h-2 bg-orange-500 rounded-full mr-1.5 animate-pulse"></span>
                Promo Minggu Ini
            </div>
        </div>

        <div class="relative z-10 container mx-auto px-2.5 mobile:px-3 tablet:px-5 py-8 mobile:py-10 tablet:py-14 desktop:py-20">
            <div class="grid grid-cols-1 tablet:grid-cols-2 gap-8 tablet:gap-12 items-center">
                {/* Left: Welcome Text + CTA */}
                <div class="text-center mobile:text-left">
                    <h1 class="text-xl mobile:text-2xl tablet:text-4xl desktop:text-5xl font-bold mb-2 mobile:mb-3 leading-tight">
                        {id.home_page.welcome}
                    </h1>
                    <p class="text-sm mobile:text-base tablet:text-xl text-orange-100 max-w-lg mb-4 mobile:mb-6 mx-auto mobile:mx-0 leading-relaxed">
                        Distributor terpercaya untuk Pilok, Onderdil &amp; Aksesoris Motor berkualitas tinggi harga terjangkau
                    </p>
                    <div class="flex flex-col mobile:flex-row gap-2 mobile:gap-3 justify-center mobile:justify-start">
                        <a
                            href="/pilok"
                            class="bg-white text-orange-600 px-5 mobile:px-6 py-2.5 rounded-full font-semibold shadow-lg hover:bg-orange-50 transition-colors duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-orange-500 text-xs mobile:text-sm"
                        >
                            Lihat Produk Pilok
                        </a>
                        <a
                            href="/katalog-warna"
                            class="border-2 border-white text-white px-5 mobile:px-6 py-2.5 rounded-full font-semibold hover:bg-white hover:text-orange-600 transition-colors duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-orange-500 text-xs mobile:text-sm"
                        >
                            Lihat Katalog Pilok
                        </a>
                    </div>
                </div>

                {/* Right: Stats Counters */}
                <div class="grid grid-cols-3 gap-2 mobile:gap-3">
                    <StatsCounter client:load endValue={totalProduk ?? 0} suffix="+" label="Produk" icon="package" duration={2000} dataType="produk"/>
                    <StatsCounter client:load endValue={totalTerjual} suffix="+" label="Terjual" icon="users" duration={2200} dataType="terjual"/>
                    <StatsCounter client:load endValue={5} suffix="" label="Rating" icon="star" duration={1800} dataType="static"/>
                </div>
            </div>
        </div>

        {/* Scroll Indicator */}
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10">
            <div class="w-6 h-10 rounded-full border-2 border-white/40 flex items-start justify-center pt-2">
                <span class="block w-1.5 h-1.5 bg-white rounded-full animate-[bounce_2s_ease-in-out_infinite]"></span>
            </div>
        </div>

        <style>
            @keyframes bounce {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(6px); }
            }
            @keyframes pulse {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.85; }
            }
        </style>
    </section>

    {/* VideoShowcase Section */}
    <VideoShowcase client:visible />

    {/* BrandMarquee Section */}
    <BrandMarquee client:visible brands={brands ?? [] as any} />

    {/* FeaturedProducts Section */}
    <FeaturedProducts client:visible />

    {/* FlashSale Section */}
    <FlashSaleSection client:visible />

    {/* Why Choose Us Section */}
    <WhyChooseUs client:visible />

    {/* Testimonial Section */}
    <TestimonialSection client:visible />

    {/* Categories Preview */}
    <CategoriesPreview client:visible />

    {/* Trust Badges */}
    <TrustBadges client:visible />

    {/* Newsletter Banner */}
    <NewsletterBanner client:visible />
</MainLayout>