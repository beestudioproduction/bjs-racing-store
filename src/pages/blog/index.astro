---
// File: /src/pages/blog/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { supabaseAdmin } from '../../lib/supabaseServer';
import FeedCard from '../../components/feed/FeedCard.jsx';
import BlogHero from '../../components/blog/BlogHero.astro';
import CategoryPills from '../../components/blog/CategoryPills.astro';
import BlogSkeleton from '../../components/blog/BlogSkeleton.jsx';

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=86400",
);

const categoryFilter = Astro.url.searchParams.get('category');

let query = supabaseAdmin
  .from('feed_posts')
  .select('*, products(id, nama, harga_jual, image_url), feed_comments(count)')
  .eq('is_published', true)
  .order('published_at', { ascending: false })
  .limit(20);

if (categoryFilter) query = query.eq('category', categoryFilter);

const posts = await query;

const featured = posts.data?.filter(p => p.is_featured) || [];
const regular = posts.data?.filter(p => !p.is_featured) || [];
const allPosts = [...featured, ...regular];
const heroPost = allPosts[0];
const gridPosts = allPosts.slice(1);

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Tips & Trik BJS Racing Store",
  "description": "Tips & trik cat semprot motor, pilok, dan onderdil dari praktisi BJS Racing Store.",
  "url": "https://bjsracing.com/blog",
  "publisher": {
    "@type": "Organization",
    "name": "BJS Racing Store",
    "logo": {
      "@type": "ImageObject",
      "url": "https://bjsracing.com/favicon.svg"
    }
  }
};
---

<MainLayout
  title="Tips & Trik Cat Semprot & Onderdil Motor | BJS Racing Store"
  description="Kumpulan tips & trik cat semprot motor, pilok, dan onderdil dari praktisi BJS Racing Store — tutorial lengkap dengan video."
  canonicalPath="/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} slot="head-scripts" />
  <link rel="alternate" type="application/rss+xml" title="Tips & Trik BJS Racing Store" href="https://bjsracing.com/rss.xml" slot="head-scripts" />

  <div class="max-w-7xl mx-auto px-4">
    <PageHeader title="Tips & Trik" subtitle="Cat semprot, sparepart, & otomotif" />

    <CategoryPills activeCategory={categoryFilter || ''} />

    {heroPost && (
      <BlogHero post={heroPost} />
    )}

    {gridPosts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {gridPosts.map((post) => (
          <FeedCard post={post} client:load />
        ))}
      </div>
    ) : allPosts.length === 0 ? (
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-slate-200 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <p class="text-slate-400 text-sm">Belum ada artikel untuk kategori ini.</p>
        <a href="/blog" class="inline-block mt-3 text-sm font-semibold text-orange-600 hover:text-orange-700">Lihat Semua Artikel →</a>
      </div>
    ) : null}

    {/* Fallback SEO tanpa JavaScript */}
    <noscript>
      <ul class="py-4 space-y-2">
        {allPosts.map((post) => (
          <li><a class="text-orange-600 underline" href={`/blog/${post.slug}`}>{post.title}</a></li>
        ))}
      </ul>
    </noscript>
  </div>
</MainLayout>
