---
// File: /src/pages/blog/[slug].astro
import MainLayout from '../../layouts/MainLayout.astro';
import { supabaseAdmin } from '../../lib/supabaseServer';
import CommentSection from '../../components/feed/CommentSection.jsx';
import YouTubeEmbed from '../../components/YouTubeEmbed';

import ArticleHero from '../../components/blog/ArticleHero.jsx';
import AuthorBadge from '../../components/blog/AuthorBadge.astro';
import TableOfContents from '../../components/blog/TableOfContents.jsx';
import ProductCarousel from '../../components/blog/ProductCarousel.jsx';
import RelatedPostCard from '../../components/blog/RelatedPostCard.jsx';

export const prerender = false;

const { slug } = Astro.params;

const { data: post } = await supabaseAdmin
  .from('feed_posts')
  .select('*, products(id, nama, harga_jual, image_url, merek, lini_produk, color_variant, color_hex, color_swatch_url, harga_coret, sku, ukuran), feed_post_products(post_id, product_id, products(id, nama, harga_jual, image_url, merek, lini_produk, color_variant, color_hex, color_swatch_url, harga_coret, sku, ukuran))')
  .eq('slug', slug)
  .eq('is_published', true)
  .single();

if (!post) {
  return new Response(
    `<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Artikel tidak ditemukan - BJS Racing Store</title>
<meta name="robots" content="noindex" />
<style>
body{font-family:system-ui,-apple-system,sans-serif;margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f8fafc;color:#1e293b;text-align:center;padding:2rem}
h1{font-size:1.5rem;margin:0 0 .5rem}
p{color:#64748b;margin:0 0 1.5rem}
a{display:inline-block;background:#f97316;color:#fff;padding:.625rem 1.25rem;border-radius:.5rem;text-decoration:none;font-weight:600}
a:hover{background:#ea580c}
</style>
</head>
<body>
<div>
<h1>Artikel tidak ditemukan</h1>
<p>Artikel yang Anda cari sudah dihapus atau alamatnya salah.</p>
<a href="/blog">Kembali ke Blog</a>
</div>
</body>
</html>`,
    {
      status: 404,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "public, s-maxage=60, stale-while-revalidate=300",
      },
    }
  );
}

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=86400",
);

function getDriveDirectUrl(url: string) {
  if (!url || !url.includes('drive.google.com')) return url;
  const idMatch = url.match(/[-\w]{25,}/);
  if (idMatch) return `https://drive.google.com/uc?export=view&id=${idMatch[0]}`;
  return url;
}

function getYouTubeId(url: string) {
  if (!url) return null;
  const regExp = /^.*((youtu.be\/)|(v\/)|(\/u\/\w\/)|(embed\/)|(watch\?)|(?:shorts\/))\??v?=?([^#&?]*).*/;
  const match = url.match(regExp);
  return match && match[7] && match[7].length === 11 ? match[7] : null;
}

const { data: prevPost } = await supabaseAdmin
  .from('feed_posts')
  .select('id, slug, title')
  .eq('is_published', true)
  .lt('published_at', post.published_at)
  .order('published_at', { ascending: false })
  .limit(1)
  .maybeSingle();

const { data: nextPost } = await supabaseAdmin
  .from('feed_posts')
  .select('id, slug, title')
  .eq('is_published', true)
  .gt('published_at', post.published_at)
  .order('published_at', { ascending: true })
  .limit(1)
  .maybeSingle();

const { data: relatedPosts } = await supabaseAdmin
  .from('feed_posts')
  .select('id, slug, title, content, published_at, media_url, youtube_url, post_type, category, is_featured, feed_comments(count)')
  .eq('is_published', true)
  .neq('id', post.id)
  .order('published_at', { ascending: false })
  .limit(4);

const relatedProducts = (post.feed_post_products ?? [])
  .map((item: any) => item.products)
  .filter(Boolean);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Beranda", item: "https://bjsracing.com/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://bjsracing.com/blog" },
    ...(post.category
      ? [{ "@type": "ListItem", position: 3, name: post.category.toLowerCase(), item: `https://bjsracing.com/blog?category=${encodeURIComponent(post.category)}` }]
      : []),
    { "@type": "ListItem", position: post.category ? 4 : 3, name: post.title, item: `https://bjsracing.com/blog/${post.slug}` },
  ],
};

const plainText = (post.content ?? '').replace(/<[^>]*>/g, ' ').trim();
const wordCount = plainText ? plainText.split(/\s+/).length : 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const ogImage = post.media_url && !post.media_url.includes('drive.google.com') ? post.media_url : null;
const postDescription = post.content?.replace(/<[^>]*>/g, '').slice(0, 160);
const youtubeVideoId = getYouTubeId(post.youtube_url);
---

<MainLayout
  title={`${post.title} - BJS Racing Blog`}
  description={postDescription || undefined}
  ogImage={ogImage || undefined}
  canonicalPath={`/blog/${post.slug}`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    image: ogImage ? [ogImage] : undefined,
    datePublished: post.published_at,
    dateModified: post.updated_at ?? post.published_at,
    author: {
      "@type": "Organization",
      name: "BJS Racing Store",
      url: "https://bjsracing.com",
    },
    publisher: {
      "@type": "Organization",
      name: "BJS Racing Store",
      logo: {
        "@type": "ImageObject",
        url: "https://bjsracing.com/favicon.svg",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `https://bjsracing.com/blog/${post.slug}`,
    },
  })} slot="head-scripts" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head-scripts" />

  {/* Reading progress bar */}
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-orange-500 z-[60] pointer-events-none transition-[width] duration-100" style="width:0%"></div>

  <div class="max-w-7xl mx-auto px-4 py-6 md:py-8">
    {/* Breadcrumb */}
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-800">
        <li><a href="/" class="hover:text-orange-500 transition-colors">Beranda</a></li>
        <li><span class="text-slate-300">/</span></li>
        <li><a href="/blog" class="hover:text-orange-500 transition-colors">Blog</a></li>
        {post.category && (
          <>
            <li><span class="text-slate-300">/</span></li>
            <li>
              <a href={`/blog?category=${encodeURIComponent(post.category)}`} class="text-orange-500 font-medium hover:text-orange-600 transition-colors">
                {post.category.replace(/_/g, ' ')}
              </a>
            </li>
          </>
        )}
      </ol>
    </nav>

    {/* Back link */}
    <a href="/blog" class="inline-flex items-center text-sm text-slate-800 hover:text-orange-500 mb-6 transition-colors">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali ke Blog
    </a>

    {/* Two-column layout: main + sidebar */}
    <div class="flex flex-col lg:flex-row gap-8">
      {/* Main content */}
      <article class="flex-1 min-w-0">
        {/* Hero media */}
        <ArticleHero
          title={post.title}
          mediaUrl={post.media_url}
          youtubeUrl={post.youtube_url}
          postType={post.post_type}
          isShort={!!post.youtube_url?.includes('/shorts/')}
          client:load
        />

        {/* Category + Featured badges */}
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="bg-orange-50 text-orange-700 text-xs font-semibold px-2.5 py-1 rounded-md border border-orange-100">
            {post.category?.replace(/_/g, ' ') || post.post_type}
          </span>
          {post.is_featured && (
            <span class="bg-red-50 text-red-600 text-xs font-semibold px-2.5 py-1 rounded-md border border-red-100">
              Unggulan
            </span>
          )}
        </div>

        {/* Title */}
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-slate-900 mb-4 leading-tight">
          {post.title}
        </h1>

        {/* Author badge */}
        <AuthorBadge publishedAt={post.published_at} readMinutes={readMinutes} />

        {/* Share bar (desktop inline) */}
        <div id="desktop-share-bar" class="hidden md:flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-100 mb-6">
          <span class="text-sm font-semibold text-slate-700 mr-1">Bagikan</span>
          <a
            href={`https://wa.me/?text=${encodeURIComponent(post.title + ' — BJS Racing ' + Astro.url.href)}`}
            target="_blank" rel="noreferrer" aria-label="Bagikan via WhatsApp"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-green-50 text-green-600 hover:bg-green-100 transition-all duration-200 text-sm font-medium"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
            WhatsApp
          </a>
          <a
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(post.title + ' — BJS Racing')}`}
            target="_blank" rel="noreferrer" aria-label="Bagikan ke X / Twitter"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black/5 text-black hover:bg-black/10 transition-all duration-200 text-sm font-medium"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
            X
          </a>
          <button
            id="desktop-share-copy"
            aria-label="Salin tautan artikel"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-orange-50 text-orange-600 hover:bg-orange-100 transition-all duration-200 text-sm font-medium cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.367-5.656l-1.1 1.1" /></svg>
            Salin
          </button>
        </div>

        {/* Article content — prose */}
        <div id="article-content" class="prose prose-slate prose-headings:scroll-mt-24 max-w-none mb-8 text-slate-700 leading-relaxed
          prose-h2:text-xl prose-h2:md:text-2xl prose-h2:font-bold prose-h2:text-slate-900 prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-l-4 prose-h2:border-orange-500 prose-h2:pl-4
          prose-h3:text-lg prose-h3:md:text-xl prose-h3:font-semibold prose-h3:text-slate-800 prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-base prose-p:leading-relaxed
          prose-a:text-orange-600 prose-a:no-underline prose-a:decoration-orange-200 hover:prose-a:decoration-orange-500
          prose-img:rounded-xl prose-img:shadow-sm prose-img:my-6
          prose-blockquote:border-orange-400 prose-blockquote:bg-orange-50/50 prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-slate-600
          prose-li:marker:text-orange-400"
          set:html={post.content}
        />

        {/* YouTube embed (non-video posts that have a YouTube URL) */}
        {(post.post_type !== 'video' || !youtubeVideoId) && post.youtube_url && youtubeVideoId && (
          <div class="mb-8">
            <YouTubeEmbed
              videoId={youtubeVideoId}
              title={post.title}
              client:load
            />
          </div>
        )}

        {/* Product carousel */}
        <ProductCarousel products={relatedProducts} client:visible />
      </article>

      {/* Sidebar — desktop only */}
      <aside class="w-full lg:w-72 flex-shrink-0 space-y-6">
        <TableOfContents client:visible />

        {/* Produk terkait compact (sidebar) */}
        {relatedProducts.length > 0 && (
          <div class="hidden lg:block">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Produk Terkait</h4>
            <div class="space-y-2">
              {relatedProducts.slice(0, 4).map((product: any) => (
                <a href={`/products/${product.id}`} class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-50 transition-colors group">
                  <div class="relative w-11 h-11 bg-slate-50 rounded-md border border-slate-100 shrink-0 flex items-center justify-center overflow-hidden">
                    {product.image_url && <img src={product.image_url} alt={product.nama} class="w-full h-full object-contain p-0.5" />}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-medium text-slate-700 line-clamp-1 group-hover:text-orange-600 transition-colors">{product.nama}</p>
                    <p class="text-xs font-bold text-orange-600">
                      {new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.harga_jual || 0)}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    {/* Comment section */}
    <div class="mt-8 max-w-4xl">
      <CommentSection postId={post.id} client:visible />
    </div>

    {/* Reading progress script */}
    <script is:inline>
      (function() {
        var bar = document.getElementById('reading-progress');
        var target = document.getElementById('article-content');
        if (!bar || !target) return;
        function update() {
          var rect = target.getBoundingClientRect();
          var total = target.offsetHeight - window.innerHeight;
          var passed = -rect.top;
          var pct = total > 0 ? Math.max(0, Math.min(100, (passed / total) * 100)) : 0;
          bar.style.width = pct + '%';
        }
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>

    {/* Desktop share bar copy link */}
    <script is:inline>
      (function() {
        var btn = document.getElementById('desktop-share-copy');
        if (!btn) return;
        btn.addEventListener('click', function() {
          navigator.clipboard.writeText(window.location.href).then(function() {
            btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Tersalin!';
            btn.classList.add('bg-green-50', 'text-green-600');
            btn.classList.remove('bg-orange-50', 'text-orange-600');
            setTimeout(function() {
              btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.367-5.656l-1.1 1.1" /></svg> Salin';
              btn.classList.remove('bg-green-50', 'text-green-600');
              btn.classList.add('bg-orange-50', 'text-orange-600');
            }, 1500);
          });
        });
      })();
    </script>

    {/* Related articles */}
    {(relatedPosts || []).length > 0 && (
      <div class="mt-10">
        <h3 class="text-xl font-bold text-slate-800 mb-5 flex items-center gap-2">
          <span class="w-1.5 h-6 bg-orange-500 rounded-full"></span>
          Artikel Terkait
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {(relatedPosts || []).map((rp: any) => (
            <RelatedPostCard post={rp} client:visible />
          ))}
        </div>
      </div>
    )}

    {/* Prev/Next navigation */}
    {(prevPost || nextPost) && (
      <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3" aria-label="Navigasi artikel">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}`}
             class="flex items-center gap-3 p-4 bg-slate-50 rounded-xl border border-slate-100 hover:border-orange-200 hover:bg-orange-50/50 group transition-colors">
            <svg class="w-5 h-5 text-orange-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <div class="min-w-0">
              <span class="text-[11px] text-slate-400 block mb-0.5">Sebelumnya</span>
              <span class="font-semibold text-sm text-slate-700 line-clamp-2 group-hover:text-orange-700 transition-colors">{prevPost.title}</span>
            </div>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}`}
             class="flex items-center justify-end gap-3 p-4 bg-slate-50 rounded-xl border border-slate-100 hover:border-orange-200 hover:bg-orange-50/50 group transition-colors sm:text-right">
            <div class="min-w-0">
              <span class="text-[11px] text-slate-400 block mb-0.5">Selanjutnya</span>
              <span class="font-semibold text-sm text-slate-700 line-clamp-2 group-hover:text-orange-700 transition-colors">{nextPost.title}</span>
            </div>
            <svg class="w-5 h-5 text-orange-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : <div />}
      </nav>
    )}
  </div>

  {/* Floating share buttons — mobile only (pure HTML, no React hydration) */}
  <div class="md:hidden fixed bottom-24 right-4 z-50 flex flex-col gap-3 items-center">
    {/* X / Twitter */}
    <a
      href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(`https://bjsracing.com/blog/${post.slug}`)}&text=${encodeURIComponent(post.title + ' — BJS Racing')}`}
      target="_blank"
      rel="noreferrer"
      class="w-12 h-12 rounded-full bg-black text-white shadow-lg flex items-center justify-center active:scale-95 transition-transform duration-150"
      aria-label="Share ke X"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
      </svg>
    </a>
    {/* Instagram */}
    <button
      id="fab-ig-share"
      data-url={`https://bjsracing.com/blog/${post.slug}`}
      data-title={post.title}
      class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 via-pink-500 to-orange-400 text-white shadow-lg flex items-center justify-center active:scale-95 transition-transform duration-150 cursor-pointer"
      aria-label="Share ke Instagram"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
        <circle cx="12" cy="12" r="5" />
        <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none" />
      </svg>
    </button>
    {/* Copy Link */}
    <button
      id="fab-copy-link"
      data-url={`https://bjsracing.com/blog/${post.slug}`}
      class="w-12 h-12 rounded-full bg-orange-500 text-white shadow-lg flex items-center justify-center active:scale-95 transition-transform duration-150 cursor-pointer"
      aria-label="Salin link"
    >
      <svg id="fab-copy-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.367-5.656l-1.1 1.1" />
      </svg>
    </button>
  </div>

  <script is:inline>
    (function() {
      var copyBtn = document.getElementById('fab-copy-link');
      if (copyBtn) {
        copyBtn.addEventListener('click', function() {
          var url = this.dataset.url;
          navigator.clipboard.writeText(url).then(function() {
            copyBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
            copyBtn.classList.remove('bg-orange-500');
            copyBtn.classList.add('bg-green-500');
            setTimeout(function() {
              copyBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.367-5.656l-1.1 1.1" /></svg>';
              copyBtn.classList.remove('bg-green-500');
              copyBtn.classList.add('bg-orange-500');
            }, 1500);
          });
        });
      }

      var igBtn = document.getElementById('fab-ig-share');
      if (igBtn) {
        igBtn.addEventListener('click', function() {
          var url = this.dataset.url;
          var title = this.dataset.title;
          if (navigator.share) {
            navigator.share({ title: title, url: url });
          } else {
            navigator.clipboard.writeText(url).then(function() {
              igBtn.classList.remove('bg-gradient-to-br');
              igBtn.classList.add('bg-green-500');
              setTimeout(function() {
                igBtn.classList.remove('bg-green-500');
                igBtn.classList.add('bg-gradient-to-br');
              }, 1500);
            });
          }
        });
      }
    })();
  </script>

</MainLayout>
